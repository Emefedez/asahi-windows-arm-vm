+// ---------------------------------------------------------------------------------------------
+// Hardware cursor (ported from viogpudo). Windows hands us the pointer image; we keep it in a 64x64
+// BGRA virtio-gpu resource and send UPDATE_CURSOR / MOVE_CURSOR on the cursor queue. The host then
+// draws the pointer itself (QEMU GTK/SDL use it as the host cursor), independent of the guest frame
+// rate. Only 32-bpp color shapes are accepted; for anything else Windows falls back to its software
+// cursor for that shape.
+
+BOOLEAN VioGpuAdapter::CreateCursor(void)
+{
+    PAGED_CODE();
+
+    const UINT size = POINTER_SIZE * POINTER_SIZE * 4;
+    UINT resid = resourceIdr.GetId();
+    ctrlQueue.CreateResource(resid, VIRTIO_GPU_FORMAT_B8G8R8A8_UNORM, POINTER_SIZE, POINTER_SIZE);
+
+    VioGpuObj *obj = new (NonPagedPoolNx) VioGpuObj();
+    if (!obj || !obj->Init(size, &m_CursorSegment) || !vidpn.GpuObjectAttach(resid, obj))
+    {
+        DbgPrint(TRACE_LEVEL_ERROR, ("<--- %s failed to create cursor resource %u\n", __FUNCTION__, resid));
+        delete obj;
+        ctrlQueue.DestroyResource(resid);
+        resourceIdr.PutId(resid);
+        return FALSE;
+    }
+    m_pCursorBuf = obj;
+    return TRUE;
+}
+
+// device_alive=FALSE during driver teardown: the queues are going away and the device reset drops host
+// resources, so only free guest memory. Sending commands there failed and bugchecked (0xE2 'QIVg').
+void VioGpuAdapter::DestroyCursor(BOOLEAN device_alive)
+{
+    PAGED_CODE();
+
+    if (m_pCursorBuf != NULL)
+    {
+        UINT id = (UINT)m_pCursorBuf->GetId();
+        if (device_alive)
+        {
+            ctrlQueue.DetachBacking(id);
+            ctrlQueue.DestroyResource(id);
+        }
+        delete m_pCursorBuf;
+        m_pCursorBuf = NULL;
+        resourceIdr.PutId(id);
+    }
+    m_CursorVisible = FALSE;
+}
+
+// Source pixel (x, y) of the pointer shape as BGRA (memory order B, G, R, A).
+static ULONG CursorSourcePixel(_In_ CONST DXGKARG_SETPOINTERSHAPE *shape, UINT x, UINT y, UINT mono_height)
+{
+    CONST BYTE *src = (CONST BYTE *)shape->pPixels;
+    if (shape->Flags.Color)
+    {
+        return *(CONST ULONG UNALIGNED *)(src + (SIZE_T)y * shape->Pitch + x * 4);
+    }
+    // Monochrome: 1-bpp AND mask rows followed by 1-bpp XOR mask rows (MSB first).
+    const BYTE bit = (BYTE)(0x80 >> (x & 7));
+    const BOOLEAN and_bit = (src[(SIZE_T)y * shape->Pitch + x / 8] & bit) != 0;
+    const BOOLEAN xor_bit = (src[(SIZE_T)(y + mono_height) * shape->Pitch + x / 8] & bit) != 0;
+    if (and_bit && !xor_bit)
+    {
+        return 0x00000000; // transparent
+    }
+    // AND=0: XOR selects white or black. AND=1,XOR=1 ("invert screen") is approximated as black.
+    return (!and_bit && xor_bit) ? 0xFFFFFFFF : 0xFF000000;
+}
+
+BOOLEAN VioGpuAdapter::FillCursor(_In_ CONST DXGKARG_SETPOINTERSHAPE *pSetPointerShape)
+{
+    PAGED_CODE();
+
+    PULONG dst = (PULONG)m_pCursorBuf->GetVirtualAddress();
+    if (!dst || !pSetPointerShape->pPixels)
+    {
+        return FALSE;
+    }
+
+    // Monochrome shapes carry both masks; Height covers both when it is twice the width.
+    UINT src_h = pSetPointerShape->Height;
+    if (pSetPointerShape->Flags.Monochrome && src_h == 2 * pSetPointerShape->Width)
+    {
+        src_h /= 2;
+    }
+    const UINT src_w = pSetPointerShape->Width;
+    const UINT factor = 100 / m_CursorScale; // 1, 2 or 4
+    const UINT out_w = min(src_w / factor, (UINT)POINTER_SIZE);
+    const UINT out_h = min(src_h / factor, (UINT)POINTER_SIZE);
+
+    RtlZeroMemory(dst, POINTER_SIZE * POINTER_SIZE * 4);
+    for (UINT y = 0; y < out_h; y++)
+    {
+        for (UINT x = 0; x < out_w; x++)
+        {
+            // Box filter over factor x factor premultiplied BGRA pixels.
+            ULONG sum[4] = {0, 0, 0, 0};
+            for (UINT dy = 0; dy < factor; dy++)
+            {
+                for (UINT dx = 0; dx < factor; dx++)
+                {
+                    const ULONG p = CursorSourcePixel(pSetPointerShape, x * factor + dx, y * factor + dy, src_h);
+                    for (UINT c = 0; c < 4; c++)
+                    {
+                        sum[c] += (p >> (8 * c)) & 0xFF;
+                    }
+                }
+            }
+            const UINT n = factor * factor;
+            dst[y * POINTER_SIZE + x] = (sum[0] / n) | ((sum[1] / n) << 8) | ((sum[2] / n) << 16) | ((sum[3] / n) << 24);
+        }
+    }
+    return TRUE;
+}
+
+NTSTATUS VioGpuAdapter::SendCursor(UINT32 type, UINT resource_id, LONG x, LONG y)
+{
+    PAGED_CODE();
+
+    PGPU_VBUFFER vbuf = NULL;
+    PGPU_UPDATE_CURSOR crsr = (PGPU_UPDATE_CURSOR)m_CursorQueue.AllocCursor(&vbuf);
+    if (!crsr)
+    {
+        return STATUS_INSUFFICIENT_RESOURCES;
+    }
+    RtlZeroMemory(crsr, sizeof(*crsr));
+    crsr->hdr.type = type;
+    crsr->resource_id = resource_id;
+    crsr->pos.scanout_id = 0;
+    crsr->pos.x = (ULONG)max(x, 0L);
+    crsr->pos.y = (ULONG)max(y, 0L);
+    crsr->hot_x = m_CursorHotX;
+    crsr->hot_y = m_CursorHotY;
+    return m_CursorQueue.QueueCursor(vbuf) == 0 ? STATUS_SUCCESS : STATUS_UNSUCCESSFUL;
+}
+
+NTSTATUS VioGpuAdapter::SetPointerShape(_In_ CONST DXGKARG_SETPOINTERSHAPE *pSetPointerShape)
+{
+    PAGED_CODE();
+
+    const UINT factor = 100 / m_CursorScale;
+    const BOOLEAN supported = (pSetPointerShape->Flags.Color || pSetPointerShape->Flags.Monochrome) &&
+                              pSetPointerShape->Width / factor <= POINTER_SIZE &&
+                              pSetPointerShape->Height / factor <= 2 * POINTER_SIZE;
+    if (!supported)
+    {
+        // Windows draws this shape with its software cursor: hide ours so the two never overlap.
+        if (m_pCursorBuf != NULL && m_CursorVisible)
+        {
+            m_CursorVisible = FALSE;
+            SendCursor(VIRTIO_GPU_CMD_UPDATE_CURSOR, 0, 0, 0);
+        }
+        return STATUS_UNSUCCESSFUL;
+    }
+    if (m_pCursorBuf == NULL && !CreateCursor())
+    {
+        return STATUS_UNSUCCESSFUL;
+    }
+    if (!FillCursor(pSetPointerShape))
+    {
+        return STATUS_UNSUCCESSFUL;
+    }
+
+    const UINT id = (UINT)m_pCursorBuf->GetId();
+    ctrlQueue.TransferToHost2D(id, 0, POINTER_SIZE, POINTER_SIZE, 0, 0);
+    m_CursorHotX = pSetPointerShape->XHot / factor;
+    m_CursorHotY = pSetPointerShape->YHot / factor;
+    // UPDATE_CURSOR carries the new image; keep it hidden until Windows reports a visible position.
+    return SendCursor(VIRTIO_GPU_CMD_UPDATE_CURSOR, m_CursorVisible ? id : 0, m_CursorX, m_CursorY);
+}
+
+NTSTATUS VioGpuAdapter::SetPointerPosition(_In_ CONST DXGKARG_SETPOINTERPOSITION *pSetPointerPosition)
+{
+    PAGED_CODE();
+
+    if (m_pCursorBuf == NULL)
+    {
+        return STATUS_UNSUCCESSFUL;
+    }
+    if (!pSetPointerPosition->Flags.Visible)
+    {
+        if (!m_CursorVisible)
+        {
+            return STATUS_SUCCESS;
+        }
+        m_CursorVisible = FALSE;
+        // resource_id 0 hides the cursor on the host.
+        return SendCursor(VIRTIO_GPU_CMD_UPDATE_CURSOR, 0, 0, 0);
+    }
+
+    const UINT id = (UINT)m_pCursorBuf->GetId();
+    m_CursorX = pSetPointerPosition->X;
+    m_CursorY = pSetPointerPosition->Y;
+    if (!m_CursorVisible)
+    {
+        m_CursorVisible = TRUE;
+        return SendCursor(VIRTIO_GPU_CMD_UPDATE_CURSOR, id, pSetPointerPosition->X, pSetPointerPosition->Y);
+    }
+    return SendCursor(VIRTIO_GPU_CMD_MOVE_CURSOR, id, pSetPointerPosition->X, pSetPointerPosition->Y);
+}
